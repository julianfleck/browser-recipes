{
  "manifest_version": 3,
  "name": "Agent Session Bridge",
  "version": "1.3.0",
  "description": "Record website macros, test them headlessly with saved authentication, and expose them as tools for agents.",
  "permissions": [
    "activeTab",
    "scripting",
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Agent Session Bridge",
    "default_popup": "popup.html"
  }
}
